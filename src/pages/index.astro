---
import {
  About,
  Blogs,
  HeroImage,
  HeroText,
  PhotographyShowcase,
  Projects,
  WorkExperience,
} from '@/components/home';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '@/config';
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  ogTitle={siteConfig.title}
  ogDescription={siteConfig.description}
>
  <section
    class='min-h-full lg:min-h-[80svh] flex items-center justify-center py-16 md:py-20'
  >
    <div class='container-fluid'>
      <div
        class='flex flex-col md:flex-row gap-x-8 gap-y-16 items-center justify-between'
      >
        <HeroText />
        <HeroImage />
      </div>
    </div>
  </section>

  <About />
  <WorkExperience />
  <Projects />
  <Blogs />
  <PhotographyShowcase />
</Layout>
