---
import Layout from '@/layouts/Layout.astro';
import PhotographyHeader from '@/components/photography/PhotographyHeader.astro';
import { collections, photostream } from '@/data/photography';
import { getCollection } from 'astro:content';

const featured = collections[0];
const activeCollectionSlugs = new Set(collections.map((collection) => collection.slug));
const allJournals = await getCollection(
  'photoJournals',
  ({ data }) => !data.draft,
);
const journals = allJournals.filter(
  ({ data }) => data.collection && activeCollectionSlugs.has(data.collection),
);
const standaloneJournals = allJournals.filter(({ data }) => !data.collection);
const tripCount = journals.length + standaloneJournals.length;
const journalCount = (slug: string) => journals.filter((journal) => journal.data.collection === slug).length;
const journalsForCollection = (slug: string) => journals.filter((journal) => journal.data.collection === slug);
const journalSlug = (id: string) => id.replace(/\.mdx?$/, '');
---

<Layout
  title='Photography & Travel – Lewis Kori'
  description='Visual journals, travel stories and quiet observations from Lewis Kori.'
  ogTitle='Field of view — Photography by Lewis Kori'
  ogDescription='A collection of visual journals from near and far.'
  image={featured.cover.src}
>
  <div class='photography-shell'>
    <div class='container-fluid'>
      <PhotographyHeader />

      <section class='grid gap-10 py-14 md:grid-cols-[1.15fr_0.85fr] md:items-end md:py-24'>
        <div>
          <p class='photo-kicker mb-5'>Photography / Travel / Observation</p>
          <h1 class='max-w-4xl text-5xl font-semibold leading-[0.95] tracking-[-0.055em] sm:text-7xl lg:text-[6.5rem]'>
            Stories found<br />between places.
          </h1>
        </div>
        <div class='md:pb-2'>
          <p class='max-w-md text-base leading-relaxed text-muted-foreground md:text-lg'>
            A home for photographs from the places I go and the moments I want to remember.
          </p>
          <div class='mt-8 flex gap-8 border-t border-border/80 pt-5 text-xs uppercase tracking-[0.16em] text-muted-foreground'>
            <span><strong class='mr-2 text-foreground'>{collections.length}</strong> Collections</span>
            <span><strong class='mr-2 text-foreground'>{tripCount}</strong> Journals</span>
          </div>
        </div>
      </section>

      <section class='pb-16 md:pb-28' aria-labelledby='collections-title'>
        <div class='mb-6 flex items-end justify-between gap-4'>
          <div>
            <p class='photo-kicker mb-2'>The long way around</p>
            <h2 id='collections-title' class='text-2xl font-semibold tracking-tight md:text-3xl'>Journeys</h2>
          </div>
          <a href='/photostream' class='photo-text-link'>Skip to the stream <span>↗</span></a>
        </div>

        <div class='space-y-8 md:space-y-12'>
          {
            collections.map((collection, index) => (
              <article class='collection-card overflow-hidden rounded-[1.5rem] border border-border/70 bg-card shadow-sm md:rounded-[1.75rem]'>
                <a href={`/photography/${collection.slug}`} class='collection-cover group relative block h-[24rem] overflow-hidden sm:h-[28rem] md:h-[32rem]'>
                  <img
                    src={collection.cover.src}
                    alt={collection.cover.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    class='absolute inset-0 size-full object-cover transition duration-500 ease-out group-hover:scale-[1.02]'
                  />
                  <div class='absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-black/20' />
                  <div class='absolute inset-0 flex flex-col justify-between p-6 text-white sm:p-8 md:p-10'>
                    <div class='flex items-center justify-between gap-4'>
                      <span class='rounded-full border border-white/30 bg-black/20 px-3 py-1.5 text-[0.65rem] font-semibold uppercase tracking-[0.2em] backdrop-blur-sm'>
                        Collection {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class='grid size-10 place-items-center rounded-full border border-white/30 bg-black/20 text-base backdrop-blur-sm transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:bg-white group-hover:text-black'>↗</span>
                    </div>
                    <div class='grid gap-4 border-t border-white/25 pt-5 md:grid-cols-[1fr_auto] md:items-end'>
                      <div>
                        <h3 class='text-4xl font-semibold tracking-[-0.04em] sm:text-5xl'>{collection.title}</h3>
                        <p class='mt-2 max-w-xl text-sm leading-relaxed text-white/75'>{collection.description}</p>
                      </div>
                      <div class='flex gap-5 text-[.68rem] uppercase tracking-[0.16em] text-white/70'>
                        <span>{journalCount(collection.slug)} {journalCount(collection.slug) === 1 ? 'journal' : 'journals'}</span>
                        <span>{collection.cover.location}</span>
                      </div>
                    </div>
                  </div>
                </a>

                {journalsForCollection(collection.slug).length > 0 && (
                  <div class='divide-y divide-white/10 bg-black'>
                    {journalsForCollection(collection.slug).map((journal, journalIndex) => (
                      <a href={`/photography/${collection.slug}/${journalSlug(journal.id)}`} class='trip-preview group relative grid min-h-36 overflow-hidden sm:min-h-40'>
                        <img src={journal.data.cover.src} alt='' loading='lazy' class='absolute inset-0 size-full object-cover transition duration-500 ease-out group-hover:scale-[1.02]' />
                        <div class='absolute inset-0 bg-gradient-to-r from-black/90 via-black/55 to-black/20 transition duration-300 group-hover:via-black/45' />
                        <div class='relative flex items-end justify-between gap-5 p-5 text-white sm:p-7'>
                          <div>
                            <p class='mb-2 text-[.62rem] font-semibold uppercase tracking-[.18em] text-white/55'>Chapter {String(journalIndex + 1).padStart(2, '0')} · {journal.data.place}</p>
                            <h4 class='text-2xl font-semibold tracking-[-.03em] sm:text-3xl'>{journal.data.title}</h4>
                            <p class='mt-1 text-sm text-white/72'>{journal.data.subtitle}</p>
                            <p class='hidden max-h-0 max-w-2xl translate-y-1 overflow-hidden text-sm leading-relaxed text-white/65 opacity-0 transition-all duration-300 group-hover:mt-2 group-hover:max-h-14 group-hover:translate-y-0 group-hover:opacity-100 md:block'>
                              {journal.data.description}
                            </p>
                          </div>
                          <span class='grid size-9 shrink-0 place-items-center rounded-full border border-white/25 bg-black/20 text-sm backdrop-blur-sm transition duration-200 group-hover:bg-white group-hover:text-black'>↗</span>
                        </div>
                      </a>
                    ))}
                  </div>
                )}
              </article>
            ))
          }

          {
            standaloneJournals.map((journal) => (
              <a href={`/photography/trips/${journalSlug(journal.id)}`} class='collection-card group relative block h-[24rem] overflow-hidden rounded-[1.5rem] border border-border/70 bg-card shadow-sm sm:h-[28rem] md:h-[32rem] md:rounded-[1.75rem]'>
                <img src={journal.data.cover.src} alt={journal.data.cover.alt} loading='lazy' class='absolute inset-0 size-full object-cover transition duration-500 ease-out group-hover:scale-[1.02]' />
                <div class='absolute inset-0 bg-gradient-to-t from-black/90 via-black/15 to-black/20' />
                <div class='absolute inset-0 flex flex-col justify-between p-6 text-white sm:p-8 md:p-10'>
                  <div class='flex items-center justify-between gap-4'>
                    <span class='rounded-full border border-white/30 bg-black/20 px-3 py-1.5 text-[0.65rem] font-semibold uppercase tracking-[0.2em] backdrop-blur-sm'>Journal</span>
                    <span class='grid size-10 place-items-center rounded-full border border-white/30 bg-black/20 text-base backdrop-blur-sm transition duration-200 group-hover:bg-white group-hover:text-black'>↗</span>
                  </div>
                  <div class='border-t border-white/25 pt-5'>
                    <p class='mb-2 text-[.68rem] font-semibold uppercase tracking-[.18em] text-white/60'>{journal.data.place}</p>
                    <h3 class='text-4xl font-semibold tracking-[-0.04em] sm:text-5xl'>{journal.data.title}</h3>
                    <p class='mt-2 max-w-2xl text-sm leading-relaxed text-white/75'>{journal.data.subtitle}</p>
                    <p class='hidden max-h-0 max-w-2xl translate-y-1 overflow-hidden text-sm leading-relaxed text-white/65 opacity-0 transition-all duration-300 group-hover:mt-2 group-hover:max-h-14 group-hover:translate-y-0 group-hover:opacity-100 md:block'>
                      {journal.data.description}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class='border-t border-border/80 py-16 md:py-24'>
        <div class='mb-8 flex flex-wrap items-end justify-between gap-5'>
          <div>
            <p class='photo-kicker mb-3'>Loose frames</p>
            <h2 class='text-3xl font-semibold tracking-[-0.04em] md:text-5xl'>Photostream</h2>
            <p class='mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground'>Single images, passing moments and everything that lives outside a trip.</p>
          </div>
          <div class='flex items-center gap-2'>
            <a href='/photostream' class='mr-2 text-sm font-semibold hover:text-secondary'>View all</a>
            <button type='button' data-stream-previous aria-label='Previous photostream images' class='stream-control grid size-10 place-items-center rounded-full border border-border bg-card text-lg transition hover:border-foreground/30 hover:bg-foreground hover:text-background disabled:cursor-not-allowed disabled:opacity-30'>←</button>
            <button type='button' data-stream-next aria-label='Next photostream images' class='stream-control grid size-10 place-items-center rounded-full border border-border bg-card text-lg transition hover:border-foreground/30 hover:bg-foreground hover:text-background disabled:cursor-not-allowed disabled:opacity-30'>→</button>
          </div>
        </div>
        <div data-stream-track class='photostream-rail -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-3 sm:-mx-0 sm:px-0 md:gap-4'>
          {photostream.map((photo, index) => (
            <a href='/photostream' class:list={['stream-card group relative h-72 shrink-0 snap-start overflow-hidden rounded-2xl bg-muted sm:h-80 md:h-96', index % 3 === 1 ? 'stream-card-narrow' : 'stream-card-wide']}>
              <img src={photo.src} alt={photo.alt} loading={index < 3 ? 'eager' : 'lazy'} class='size-full object-cover transition duration-500 group-hover:scale-[1.025]' />
              <div class='absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent opacity-80 transition group-hover:opacity-100'></div>
              <div class='absolute inset-x-0 bottom-0 translate-y-2 p-5 text-white opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100'>
                <p class='text-sm font-semibold'>{photo.title || photo.location || photo.alt}</p>
                {photo.location && <p class='mt-1 text-xs text-white/65'>{photo.location}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .photography-shell { padding-top: 1rem; }
  .photo-kicker { font-size: .67rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted-foreground); }
  .photo-text-link { display: inline-flex; align-items: center; gap: .5rem; font-size: .78rem; font-weight: 650; }
  .photo-text-link span { transition: transform .25s ease; }
  .photo-text-link:hover span { transform: translate(.2rem, -.2rem); }
  .collection-card, .collection-cover, .trip-preview { isolation: isolate; }
  .photostream-rail { scrollbar-width: none; overscroll-behavior-inline: contain; }
  .photostream-rail::-webkit-scrollbar { display: none; }
  .stream-card-wide { width: min(82vw, 31rem); }
  .stream-card-narrow { width: min(66vw, 23rem); }
  @media (min-width: 640px) {
    .stream-card-wide { width: min(52vw, 31rem); }
    .stream-card-narrow { width: min(36vw, 23rem); }
  }
  @media (min-width: 1024px) {
    .stream-card-wide { width: min(40vw, 34rem); }
    .stream-card-narrow { width: min(24vw, 23rem); }
  }
  @media (hover: none) {
    .stream-card > div:last-child { transform: none; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collection-card img, .stream-card img { transition: none; }
    .photostream-rail { scroll-behavior: auto; }
  }
</style>

<script>
  function initPhotostreamRail() {
    const track = document.querySelector<HTMLElement>('[data-stream-track]');
    const previous = document.querySelector<HTMLButtonElement>('[data-stream-previous]');
    const next = document.querySelector<HTMLButtonElement>('[data-stream-next]');
    if (!track || !previous || !next || track.dataset.ready === 'true') return;

    track.dataset.ready = 'true';

    const updateControls = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      previous.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= maxScroll - 4;
    };

    const move = (direction: number) => {
      const distance = Math.max(track.clientWidth * 0.78, 260);
      track.scrollBy({
        left: distance * direction,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls, { passive: true });
    updateControls();
  }

  initPhotostreamRail();
  document.addEventListener('astro:page-load', initPhotostreamRail);
</script>
