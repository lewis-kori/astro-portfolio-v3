---
import Navbar from '@/components/navs/Navbar.astro';
import Footer from '@/components/navs/Footer.astro';
import '../styles/global.css';
import BackgroundArt from '@/components/shared/BackgroundArt.astro';
import StickySocials from '@/components/shared/StickySocials.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { siteConfig } from '@/config';
import { SITE_URL } from '@/lib/env';
import { GTM_ID } from 'astro:env/client';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  type?: 'website' | 'article';
  canonical?: string;
  breadcrumbs?: Array<{ name: string; item: string }>;
  keywords?: string[];
  articleType?: 'Article' | 'BlogPosting';
  galleryImages?: string[];
  contentLocation?: string;
  temporalCoverage?: string;
  noindex?: boolean;
}

const siteName = siteConfig.name;
const siteUrl = SITE_URL;
const isPhotographyPage = /^\/photography(?:\/|$)|^\/photostream\/?$/.test(Astro.url.pathname);
const photographyPageFade = fade({ duration: '180ms' });
const defaultDescription = siteConfig.description;
const defaultOgTitle = siteConfig.title;
const defaultOgDescription = siteConfig.description;

const {
  title = siteConfig.title,
  description = defaultDescription,
  ogTitle = defaultOgTitle,
  ogDescription = defaultOgDescription,
  image = `${siteUrl}/opengraph.png`,
  author = 'Lewis Kori',
  publishedTime,
  modifiedTime,
  type = 'website',
  canonical,
  breadcrumbs,
  keywords,
  articleType = 'Article',
  galleryImages = [],
  contentLocation,
  temporalCoverage,
  noindex = false,
} = Astro.props;

const pageTitle = title;
const openGraphTitle = ogTitle || pageTitle;
const openGraphDescription = ogDescription || description;
const canonicalUrl = canonical || Astro.url;
const defaultOgImage = `${siteUrl}/opengraph.png`;
const isDefaultOgImage = image === defaultOgImage;
---

<!doctype html>
<html
  transition:name='root'
  transition:animate='none'
  lang='en'
  class='light'
  data-photography-page={isPhotographyPage ? '' : undefined}
>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='shortcut icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <meta name='apple-mobile-web-app-title' content='Lewis Portfolio' />
    <link rel='manifest' href='/site.webmanifest' />
    <meta name='generator' content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- SEO Meta Tags -->
    <meta name='description' content={description} />
    <meta name='author' content={author} />
    {noindex && <meta name='robots' content='noindex, nofollow' />}
    {keywords && keywords.length > 0 && (
      <meta name='keywords' content={keywords.join(', ')} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content={type} />
    <meta property='og:locale' content='en_US' />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:title' content={openGraphTitle} />
    <meta property='og:description' content={openGraphDescription} />
    <meta property='og:image' content={image} />
    <meta property='og:image:secure_url' content={image} />
    {isDefaultOgImage && <meta property='og:image:type' content='image/png' />}
    {isDefaultOgImage && <meta property='og:image:width' content='1200' />}
    {isDefaultOgImage && <meta property='og:image:height' content='630' />}
    <meta property='og:image:alt' content={openGraphTitle} />
    <meta property='og:site_name' content={siteName} />
    {
      publishedTime && (
        <meta property='article:published_time' content={publishedTime} />
      )
    }
    {
      author && type === 'article' && (
        <meta property='article:author' content={author} />
      )
    }

    <!-- Twitter -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@lewis_kihiu' />
    <meta name='twitter:creator' content='@lewis_kihiu' />
    <meta name='twitter:url' content={canonicalUrl} />
    <meta name='twitter:title' content={openGraphTitle} />
    <meta name='twitter:description' content={openGraphDescription} />
    <meta name='twitter:image' content={image} />
    <meta name='twitter:image:alt' content={openGraphTitle} />

    <!-- Canonical URL -->
    <link rel='canonical' href={canonicalUrl} />
    <!-- Sitemap -->
    <link rel='sitemap' href='/sitemap-index.xml' />
    <link
      rel='alternate'
      type='application/rss+xml'
      title='Lewis Kori — Articles'
      href='/rss.xml'
    />

    <!-- Structured Data / JSON-LD -->
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            url: siteUrl,
            name: siteName,
            description: defaultDescription,
            publisher: {
              '@id': `${siteUrl}/#person`,
            },
            inLanguage: 'en-US',
          },
          {
            '@type': 'Person',
            '@id': `${siteUrl}/#person`,
            name: 'Lewis Kori',
            alternateName: 'Lewis Kihiu',
            url: siteUrl,
            image: {
              '@type': 'ImageObject',
              url: `${siteUrl}/opengraph.png`,
              width: 1200,
              height: 630,
            },
            description: siteConfig.authorDescription,
            jobTitle: 'Software Engineer, Product Builder and Business Operator',
            hasOccupation: [
              {
                '@type': 'Occupation',
                name: 'Software Engineer',
                occupationLocation: {
                  '@type': 'City',
                  name: 'Nairobi',
                },
              },
              {
                '@type': 'Occupation',
                name: 'Product Builder and Business Operator',
              },
              {
                '@type': 'Occupation',
                name: 'Technology Advisor',
              },
            ],
            address: {
              '@type': 'PostalAddress',
              addressCountry: 'KE',
              addressLocality: 'Nairobi',
            },
            worksFor: {
              '@type': 'Organization',
              name: 'Inflection Studio',
              url: 'https://inflectionstudio.io/',
            },
            knowsAbout: [
              'Entrepreneurship',
              'Product Development',
              'Software Engineering',
              'Technical Leadership',
              'Venture Building',
              'Technology Strategy',
              'Platform Architecture',
              'Advisory',
              'Systems Thinking',
            ],
            sameAs: [
              'https://twitter.com/lewis_kihiu',
              'https://github.com/lewis-kori',
              'https://linkedin.com/in/lewis-kihiu-aba63011b/',
              'https://inflectionstudio.io/team/lewis-kori/',
            ],
          },
          type === 'article' && publishedTime
            ? {
                '@type': articleType,
                '@id': `${Astro.url}#article`,
                headline: openGraphTitle,
                description: openGraphDescription,
                image: galleryImages.length > 0 ? galleryImages : image,
                datePublished: publishedTime,
                dateModified: modifiedTime || publishedTime,
                author: {
                  '@id': `${siteUrl}/#person`,
                },
                publisher: {
                  '@id': `${siteUrl}/#person`,
                },
                mainEntityOfPage: {
                  '@type': 'WebPage',
                  '@id': Astro.url,
                },
                ...(contentLocation && {
                  contentLocation: {
                    '@type': 'Place',
                    name: contentLocation,
                  },
                }),
                ...(temporalCoverage && { temporalCoverage }),
                ...(keywords && keywords.length > 0 && {
                  keywords: keywords.join(', '),
                  articleSection: keywords[0],
                }),
              }
            : {
                '@type': 'WebPage',
                '@id': `${Astro.url}#webpage`,
                url: Astro.url,
                name: openGraphTitle,
                description: openGraphDescription,
                isPartOf: {
                  '@id': `${siteUrl}/#website`,
                },
                primaryImageOfPage: {
                  '@type': 'ImageObject',
                  url: image,
                },
                inLanguage: 'en-US',
              },
          ...(galleryImages.length > 0
            ? [
                {
                  '@type': 'ImageGallery',
                  '@id': `${canonical || Astro.url}#gallery`,
                  name: `${openGraphTitle} photo gallery`,
                  description: openGraphDescription,
                  image: galleryImages.map((url) => ({
                    '@type': 'ImageObject',
                    contentUrl: url,
                  })),
                  isPartOf: {
                    '@id': type === 'article' && publishedTime
                      ? `${Astro.url}#article`
                      : `${Astro.url}#webpage`,
                  },
                },
              ]
            : []),
          ...(breadcrumbs && breadcrumbs.length > 0
            ? [
                {
                  '@type': 'BreadcrumbList',
                  '@id': `${canonical || Astro.url}#breadcrumb`,
                  itemListElement: breadcrumbs.map((crumb, idx) => ({
                    '@type': 'ListItem',
                    position: idx + 1,
                    name: crumb.name,
                    item: crumb.item,
                  })),
                },
              ]
            : []),
        ].filter(Boolean),
      })}
    />

    <Font cssVariable='--font-inter' />

    <ClientRouter />

    <!-- Initialize theme before page renders to prevent flash -->
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.className = theme;
      })();
    </script>

    <script>
      document.addEventListener('astro:after-swap', () => {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.classList.remove('light', 'dark', 'retro');
        document.documentElement.classList.add(theme);
      });
    </script>

    <script>
      function initPhotographyReveals() {
        const targets = document.querySelectorAll<HTMLElement>(
          'main[data-photography-page] [data-photo-reveal], main[data-photography-page] .photo-journal-copy > *',
        );

        if (!targets.length) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion || !('IntersectionObserver' in window)) {
          targets.forEach((target) => target.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        targets.forEach((target, index) => {
          target.classList.add('photo-reveal-ready');
          target.style.transitionDelay = `${Math.min(index % 5, 4) * 45}ms`;
          observer.observe(target);
        });
      }

      document.addEventListener('astro:page-load', initPhotographyReveals);
    </script>

    <!-- Google Tag Manager - Deferred Loading -->
    <script is:inline define:vars={{ GTM_ID }}>
      function loadGTM() {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          'gtm.start': new Date().getTime(),
          event: 'gtm.js',
        });

        var f = document.getElementsByTagName('script')[0],
          j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
        f.parentNode.insertBefore(j, f);
      }

      // Load GTM after page is interactive
      if (document.readyState === 'complete') {
        setTimeout(loadGTM, 1000);
      } else {
        window.addEventListener('load', function () {
          setTimeout(loadGTM, 1000);
        });
      }

      // Also load on first user interaction
      ['mousedown', 'touchstart', 'keydown', 'scroll'].forEach(
        function (event) {
          document.addEventListener(event, loadGTM, {
            once: true,
            passive: true,
          });
        },
      );
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height='0'
        width='0'
        style='display:none;visibility:hidden'></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <BackgroundArt />
    <Navbar />
    <main
      class='min-h-screen overflow-x-clip'
      data-photography-page={isPhotographyPage ? '' : undefined}
      transition:name='page-content'
      transition:animate={isPhotographyPage ? photographyPageFade : 'none'}
    >
      <slot />
    </main>
    <div transition:persist='footer'>
      <Footer />
    </div>
    <div transition:persist='socials'>
      <StickySocials />
    </div>
  </body><style is:global>
    html[data-photography-page] {
      scroll-behavior: auto;
    }

    body {
      font-family: var(--font-inter), sans-serif;
    }

    main[data-photography-page] .photo-reveal-ready {
      opacity: 0;
      transform: translate3d(0, 1.25rem, 0) scale(0.99);
      transition:
        opacity 620ms cubic-bezier(0.2, 0.7, 0.2, 1),
        transform 620ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    main[data-photography-page] .photo-reveal-ready.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      main[data-photography-page] .photo-reveal-ready {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</html>
