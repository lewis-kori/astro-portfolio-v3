---
import { getCollection } from 'astro:content';
import { collections, photostream } from '@/data/photography';

const standaloneJournals = (await getCollection(
  'photoJournals',
  ({ data }) => !data.draft && !data.collection,
)).slice(0, 6);
const journalSlug = (id: string) => id.replace(/\.mdx?$/, '');

const photosetCards = [
  ...collections.map((collection) => ({
    title: collection.title,
    eyebrow: 'Collection',
    image: collection.cover.src,
    alt: collection.cover.alt,
    href: `/photography/${collection.slug}`,
  })),
  ...standaloneJournals.map((journal) => ({
    title: journal.data.title,
    eyebrow: journal.data.place,
    image: journal.data.cover.src,
    alt: journal.data.cover.alt,
    href: `/photography/trips/${journalSlug(journal.id)}`,
  })),
];
---

<section class='pb-20 pt-4 md:pb-28 md:pt-8' aria-labelledby='home-photography-title'>
  <div class='container-fluid'>
    <div data-home-gallery class='overflow-hidden rounded-[1.75rem] border border-border/70 bg-card/55 px-4 py-6 shadow-sm sm:px-7 sm:py-8 md:px-10 md:py-10'>
      <div class='mb-7 md:mb-9'>
        <div class='flex flex-wrap items-center justify-between gap-5'>
          <div id='home-photography-title' class='flex items-center gap-5 sm:gap-8' role='tablist' aria-label='Photography preview'>
            <button type='button' role='tab' aria-selected='true' aria-controls='home-photosets-panel' data-gallery-tab='photosets' class='gallery-tab text-2xl font-semibold tracking-[-.035em] text-foreground transition sm:text-3xl'>Photosets</button>
            <button type='button' role='tab' aria-selected='false' aria-controls='home-stream-panel' data-gallery-tab='stream' class='gallery-tab text-2xl font-semibold tracking-[-.035em] text-muted-foreground/45 transition hover:text-muted-foreground sm:text-3xl'>Photostream</button>
          </div>

          <div class='flex items-center gap-2'>
            <a data-gallery-view-all href='/photography' class='mr-2 text-sm font-semibold hover:text-secondary'>View all</a>
            <button type='button' data-gallery-previous aria-label='Previous photography cards' class='grid size-10 place-items-center rounded-full border border-border bg-background/70 text-lg transition hover:border-foreground/30 hover:bg-foreground hover:text-background disabled:cursor-not-allowed disabled:opacity-30'>←</button>
            <button type='button' data-gallery-next aria-label='Next photography cards' class='grid size-10 place-items-center rounded-full border border-border bg-background/70 text-lg transition hover:border-foreground/30 hover:bg-foreground hover:text-background disabled:cursor-not-allowed disabled:opacity-30'>→</button>
          </div>
        </div>
        <p class='mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg'>
          Photographs and visual stories from the places I go and the moments I want to remember.
        </p>
      </div>

      <div id='home-photosets-panel' role='tabpanel' data-gallery-panel='photosets'>
        <div data-gallery-track class='gallery-track flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 md:gap-4'>
          {photosetCards.map((card, index) => (
            <a href={card.href} class:list={['gallery-card group relative h-[22rem] shrink-0 snap-start overflow-hidden rounded-2xl bg-muted sm:h-[26rem]', index % 4 === 2 ? 'gallery-card-narrow' : 'gallery-card-wide']}>
              <img src={card.image} alt={card.alt} loading='lazy' decoding='async' fetchpriority='low' class='size-full object-cover transition duration-500 ease-out group-hover:scale-[1.025]' />
              <div class='absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-black/10'></div>
              <div class='absolute inset-x-0 bottom-0 p-5 text-white sm:p-6'>
                <p class='mb-2 text-[.62rem] font-semibold uppercase tracking-[.18em] text-white/60'>{card.eyebrow}</p>
                <h3 class='text-2xl font-semibold tracking-[-.03em] sm:text-3xl'>{card.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div id='home-stream-panel' role='tabpanel' data-gallery-panel='stream' hidden>
        <div data-gallery-track class='gallery-track flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 md:gap-4'>
          {photostream.map((photo, index) => (
            <a href='/photostream' class:list={['gallery-card group relative h-[22rem] shrink-0 snap-start overflow-hidden rounded-2xl bg-muted sm:h-[26rem]', index % 3 === 1 ? 'gallery-card-narrow' : 'gallery-card-wide']}>
              <img src={photo.src} alt={photo.alt} loading='lazy' decoding='async' fetchpriority='low' class='size-full object-cover transition duration-500 ease-out group-hover:scale-[1.025]' />
              <div class='absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent'></div>
              <div class='absolute inset-x-0 bottom-0 p-5 text-white sm:p-6'>
                <p class='mb-2 text-[.62rem] font-semibold uppercase tracking-[.18em] text-white/60'>{photo.location || 'Loose frame'}</p>
                <h3 class='text-2xl font-semibold tracking-[-.03em] sm:text-3xl'>{photo.title || photo.alt}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-track { scrollbar-width: none; overscroll-behavior-inline: contain; }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-card-wide { width: min(78vw, 27rem); }
  .gallery-card-narrow { width: min(62vw, 21rem); }
  @media (min-width: 640px) {
    .gallery-card-wide { width: min(44vw, 27rem); }
    .gallery-card-narrow { width: min(32vw, 21rem); }
  }
  @media (min-width: 1024px) {
    .gallery-card-wide { width: min(30vw, 27rem); }
    .gallery-card-narrow { width: min(22vw, 21rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-card img { transition: none; }
  }
</style>

<script>
  function initHomePhotographyGallery() {
    document.querySelectorAll<HTMLElement>('[data-home-gallery]').forEach((gallery) => {
      if (gallery.dataset.ready === 'true') return;
      gallery.dataset.ready = 'true';

      const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-tab]'));
      const panels = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-panel]'));
      const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
      const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
      const viewAll = gallery.querySelector<HTMLAnchorElement>('[data-gallery-view-all]');
      let activePanel = 'photosets';

      const getTrack = () => gallery.querySelector<HTMLElement>(`[data-gallery-panel="${activePanel}"] [data-gallery-track]`);

      const updateControls = () => {
        const track = getTrack();
        if (!track || !previous || !next) return;
        const maxScroll = track.scrollWidth - track.clientWidth;
        previous.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= maxScroll - 4;
      };

      const selectPanel = (name: string) => {
        activePanel = name;
        tabs.forEach((tab) => {
          const selected = tab.dataset.galleryTab === name;
          tab.setAttribute('aria-selected', String(selected));
          tab.classList.toggle('text-foreground', selected);
          tab.classList.toggle('text-muted-foreground/45', !selected);
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.galleryPanel !== name;
        });
        if (viewAll) viewAll.href = name === 'stream' ? '/photostream' : '/photography';
        requestAnimationFrame(updateControls);
      };

      const move = (direction: number) => {
        const track = getTrack();
        if (!track) return;
        track.scrollBy({
          left: Math.max(track.clientWidth * .78, 260) * direction,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => selectPanel(tab.dataset.galleryTab || 'photosets')));
      panels.forEach((panel) => panel.querySelector('[data-gallery-track]')?.addEventListener('scroll', updateControls, { passive: true }));
      previous?.addEventListener('click', () => move(-1));
      next?.addEventListener('click', () => move(1));
      window.addEventListener('resize', updateControls, { passive: true });
      selectPanel('photosets');
    });
  }

  initHomePhotographyGallery();
  document.addEventListener('astro:page-load', initHomePhotographyGallery);
</script>
