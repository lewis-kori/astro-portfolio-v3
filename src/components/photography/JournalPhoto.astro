---
import type { Photo } from '@/data/photography';

interface Props extends Photo {
  width?: 'content' | 'wide' | 'full';
}

const { width = 'wide', ...photo } = Astro.props;
const aspectClass = photo.aspect === 'portrait'
  ? 'aspect-[4/5]'
  : photo.aspect === 'square'
    ? 'aspect-square'
    : photo.aspect === 'wide'
      ? 'aspect-[16/8]'
      : 'aspect-[16/10]';
---

<figure class:list={['journal-media my-10 md:my-16', width === 'content' && 'journal-content-media', width === 'full' && 'journal-full-media']}>
  <button
    data-lightbox
    data-full={photo.src}
    data-alt={photo.alt}
    data-caption={photo.caption || photo.location || photo.alt}
    data-title={photo.title || photo.caption || photo.alt}
    data-date={photo.takenAt}
    data-camera={photo.camera}
    data-lens={photo.lens}
    data-location={photo.location}
    class='group relative block w-full cursor-zoom-in overflow-hidden rounded-xl bg-muted text-left md:rounded-2xl'
  >
    <img src={photo.src} alt={photo.alt} loading='lazy' class:list={['w-full object-cover transition duration-700 group-hover:scale-[1.015]', aspectClass]} />
    <span class='absolute bottom-4 right-4 grid size-9 place-items-center rounded-full bg-black/35 text-xs text-white opacity-0 backdrop-blur-md transition group-hover:opacity-100'>↗</span>
  </button>
  {(photo.caption || photo.location) && <figcaption class='mt-3 text-xs text-muted-foreground'>{photo.caption || photo.location}</figcaption>}
</figure>
